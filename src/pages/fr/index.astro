---
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n';
import type { Lang } from '../../i18n';

const lang: Lang = 'fr';
const t = useTranslations(lang);
const otherLang = 'en';
const currentYear = new Date().getFullYear();
---

<Layout lang={lang} title={t('title')}>
  <div class="shell">

    <!-- TITLEBAR -->
    <div class="titlebar">
      <div class="titlebar-top">
        <span>{t('titlebar.left')}</span>
        <div class="lang-switcher">
          <a href={`/${lang}/`} class="active">FR</a>
          <span class="sep">&nbsp;|&nbsp;</span>
          <a href={`/${otherLang}/`}>EN</a>
        </div>
        <span>{t('titlebar.right')}</span>
      </div>
      <div class="titlebar-content">
        <div class="ascii-banner">
{`_                              _           _____                       _
| |    ___ _ __  _ __  _   _   | |    ___  |_   _|_   _ _ __ __ _ _ __ | |_
| |   / _ \\ '_ \\| '_ \\| | | |  | |   / _ \\   | | | | | | '__/ _\` | '_ \\| __|
| |__|  __/ | | | | | | |_| |  | |__|  __/   | | | |_| | | | (_| | | | | |_
|_____\\___|_| |_|_| |_|\\__, |  |_____\\___|   |_|  \\__, |_|  \\__,_|_| |_|\\__|
                        |___/                      |___/`}
        </div>
        <div class="subtitle">{t('subtitle')}</div>
      </div>
    </div>

    <!-- NAV -->
    <div class="panel">
      <div class="nav">
        <a href="#intro">{t('nav.intro')}</a>
        <a href="#seerdesk">{t('nav.seerdesk')}</a>
        <a href="#formation">{t('nav.education')}</a>
        <a href="#projets">{t('nav.projects')}</a>
        <a href="#competitions">{t('nav.competitions')}</a>
        <a href="#contact">{t('nav.contact')}</a>
      </div>
    </div>

    <!-- INTRO -->
    <div class="panel" id="intro">
      <div class="panel-header">
        <span class="tag">01</span>
        <span class="label">{t('section.intro')}</span>
      </div>
      <div class="panel-body">
        <div class="intro-text">
          <Fragment set:html={t('intro.text')} />
        </div>
      </div>
    </div>

    <!-- SEERDESK -->
    <div class="panel" id="seerdesk">
      <div class="panel-header">
        <span class="tag">02</span>
        <span class="label">{t('section.seerdesk')}</span>
      </div>
      <div class="panel-body sub-list">
        <div class="sub">
          <div class="sub-label">{t('seerdesk.roleLabel')}</div>
          <div class="role-header">
            <span class="role-title">{t('seerdesk.role')}</span>
            <span class="role-year">{t('seerdesk.roleYear')}</span>
          </div>
          <p class="sub-text role-desc">{t('seerdesk.roleDesc')}</p>
        </div>

        <div class="sub">
          <div class="sub-label">{t('seerdesk.aboutLabel')}</div>
          <p class="sub-text">{t('seerdesk.about')}</p>
          <a class="site-link" href={t('seerdesk.url')}>&gt; {t('seerdesk.urlLabel')}</a>
        </div>

        <div class="sub">
          <div class="sub-label">{t('seerdesk.stackLabel')}</div>
          <div class="tech-stack">
            <span class="tech-tag">Go</span>
            <span class="tech-tag">C++</span>
            <span class="tech-tag">TypeScript</span>
            <span class="tech-tag">React</span>
            <span class="tech-tag">Electron</span>
            <span class="tech-tag">WebRTC</span>
            <span class="tech-tag">libdatachannel</span>
            <span class="tech-tag">SDL3</span>
            <span class="tech-tag">NVENC</span>
            <span class="tech-tag">AMF</span>
            <span class="tech-tag">QSV</span>
            <span class="tech-tag">AV1</span>
            <span class="tech-tag">VP9</span>
            <span class="tech-tag">PostgreSQL</span>
            <span class="tech-tag">OpenFGA</span>
            <span class="tech-tag">OIDC</span>
            <span class="tech-tag">Android</span>
          </div>
        </div>

        <div class="sub">
          <div class="sub-label">{t('seerdesk.archLabel')}</div>
          <pre class="arch">
{`  +--------------+   WSS   +--------------------+   WSS   +--------------+
  | Desktop app  |-------->|    seerdesk-api    |<--------| host-service |
  | Electron UI  |  REST   | REST + signalling  |  signed | daemon  (Go) |
  +------+-------+         +----+----------+----+         +------+-------+
         | launches             |          |                     | supervises
  +------v-------+      +-------v----+ +---v------+       +------v-------+   +-----------+
  | Viewer       |      | PostgreSQL | | OpenFGA  |       | Host engine  |<--| Virtual   |
  | engine (C++) |      |    (HA)    | | (AuthZ)  |       | (C++)        |   | display   |
  | decode+SDL3  |      +------------+ +----------+       | capture+enc  |   | driver    |
  +------+-------+                                        +------+-------+   | (Windows) |
         |                                                       |           +-----------+
         +=========== WebRTC P2P : video, audio, input ==========+
                     FEC (Reed-Solomon) + file transfer`}
          </pre>
        </div>
      </div>
    </div>

    <!-- EDUCATION -->
    <div class="panel" id="formation">
      <div class="panel-header">
        <span class="tag">03</span>
        <span class="label">{t('section.education')}</span>
      </div>
      <div class="panel-body edu-list">

        <div class="edu">
          <div class="edu-year">{t('edu.1.year')}</div>
          <div class="edu-body">
            <div class="edu-school">{t('edu.1.school')}</div>
            <div class="edu-degree">{t('edu.1.degree')}</div>
            <div class="edu-meta">{t('edu.1.full')}</div>
            <div class="edu-role">{t('edu.1.roles')}</div>
          </div>
        </div>

        <div class="edu">
          <div class="edu-year">{t('edu.2.year')}</div>
          <div class="edu-body">
            <div class="edu-school">{t('edu.2.school')}</div>
            <div class="edu-degree">{t('edu.2.degree')}</div>
            <div class="edu-meta">{t('edu.2.skills')}</div>
            <div class="edu-role">{t('edu.2.roles')}</div>
          </div>
        </div>

        <div class="edu">
          <div class="edu-year">{t('edu.3.year')}</div>
          <div class="edu-body">
            <div class="edu-school">{t('edu.3.school')}</div>
            <div class="edu-degree">{t('edu.3.degree')}</div>

          </div>
        </div>

      </div>
    </div>

    <!-- PROJECTS -->
    <div class="panel" id="projets">
      <div class="panel-header">
        <span class="tag">04</span>
        <span class="label">{t('section.projects')}</span>
      </div>
      <div class="panel-body">

        <div class="project">
          <div class="project-header">
            <span class="tree-line">+-</span>
            <span class="project-name">{t('projects.balz.name')}</span>
            <span class="project-year">{t('projects.balz.year')}</span>
          </div>
          <div class="project-desc">
            <span class="tree-line">|&nbsp;&nbsp;</span>{t('projects.balz.desc')}<br>
            <span class="tree-line">|&nbsp;&nbsp;</span>{t('projects.balz.desc2')}
          </div>
        </div>

        <div class="project">
          <div class="project-header">
            <span class="tree-line">+-</span>
            <span class="project-name">{t('projects.cigar3.name')}</span>
            <span class="project-year">{t('projects.cigar3.year')}</span>
          </div>
          <div class="project-desc">
            <span class="tree-line">|&nbsp;&nbsp;</span>{t('projects.cigar3.desc')}<br>
            <span class="tree-line">|&nbsp;&nbsp;</span><a class="project-link" href="https://github.com/LituDev/Cigar3">{t('projects.cigar3.link')}</a>
          </div>
        </div>

        <div class="project">
          <div class="project-header">
            <span class="tree-line">+-</span>
            <span class="project-name">{t('projects.sixctf1.name')}</span>
            <span class="project-year">{t('projects.sixctf1.year')}</span>
          </div>
          <div class="project-desc">
            <span class="tree-line">|&nbsp;&nbsp;</span>{t('projects.sixctf1.desc')}<br>
            <span class="tree-line">|&nbsp;&nbsp;</span><a class="project-link" href="https://github.com/LituDev/SIX-CTF-X-HACK2G2">{t('projects.sixctf1.link')}</a>
          </div>
        </div>

        <div class="project">
          <div class="project-header">
            <span class="tree-line">+-</span>
            <span class="project-name">{t('projects.sixctf2.name')}</span>
            <span class="project-year">{t('projects.sixctf2.year')}</span>
          </div>
          <div class="project-desc">
            <span class="tree-line">|&nbsp;&nbsp;</span>{t('projects.sixctf2.desc')}<br>
            <span class="tree-line">|&nbsp;&nbsp;</span><a class="project-link" href="https://github.com/LituDev/SIXCTF-II">{t('projects.sixctf2.link')}</a>
          </div>
        </div>


      </div>
    </div>

    <!-- COMPETITIONS -->
    <div class="panel" id="competitions">
      <div class="panel-header">
        <span class="tag">05</span>
        <span class="label">{t('section.competitions')}</span>
      </div>
      <div class="panel-body">

        <div class="comp">
          <div><span class="comp-rank">{t('comp.1.rank')}</span> <span class="comp-event">{t('comp.1.event')}</span></div>
          <div class="comp-detail">{t('comp.1.detail')}</div>
        </div>

        <div class="comp">
          <div><span class="comp-rank">{t('comp.2.rank')}</span> <span class="comp-event">{t('comp.2.event')}</span></div>
          <div class="comp-detail">{t('comp.2.detail')}</div>
        </div>

        <div class="comp">
          <div><span class="comp-rank">{t('comp.3.rank')}</span> <span class="comp-event">{t('comp.3.event')}</span></div>
          <div class="comp-detail">{t('comp.3.detail')}</div>
        </div>

        <div class="comp">
          <div><span class="comp-rank">{t('comp.4.rank')}</span> <span class="comp-event">{t('comp.4.event')}</span></div>
          <div class="comp-detail">{t('comp.4.detail')}</div>
        </div>

        <div class="comp">
          <div><span class="comp-rank">{t('comp.5.rank')}</span> <span class="comp-event">{t('comp.5.event')}</span></div>
          <div class="comp-detail">{t('comp.5.detail')}</div>
        </div>

        <div class="comp">
          <div><span class="comp-rank">{t('comp.8.rank')}</span> <span class="comp-event">{t('comp.8.event')}</span></div>
          <div class="comp-detail">{t('comp.8.detail')}</div>
        </div>

        <div class="comp">
          <div><span class="comp-rank">{t('comp.6.rank')}</span> <span class="comp-event">{t('comp.6.event')}</span></div>
          <div class="comp-detail">{t('comp.6.detail')}</div>
        </div>

        <div class="comp">
          <div><span class="comp-rank">{t('comp.7.rank')}</span> <span class="comp-event">{t('comp.7.event')}</span></div>
          <div class="comp-detail">{t('comp.7.detail')}</div>
        </div>

        <div class="comp">
          <div><span class="comp-rank">{t('comp.9.rank')}</span> <span class="comp-event">{t('comp.9.event')}</span></div>
          <div class="comp-detail">{t('comp.9.detail')}</div>
        </div>

      </div>
    </div>

    <!-- CONTACT -->
    <div class="panel" id="contact">
      <div class="panel-header">
        <span class="tag">06</span>
        <span class="label">{t('section.contact')}</span>
      </div>
      <div class="panel-body">
        <div class="contact-grid">
          <div class="contact-item">
            <span class="contact-label">X / Twitter</span>
            <a class="project-link" href="https://x.com/litudev_">@litudev_</a>
          </div>
          <div class="contact-item">
            <span class="contact-label">GitHub</span>
            <a class="project-link" href="https://github.com/LituDev">@LituDev</a>
          </div>
          <div class="contact-item">
            <span class="contact-label">Discord</span>
            <span class="contact-value">litudev</span>
          </div>
          <div class="contact-item">
            <span class="contact-label">Email</span>
            <a class="project-link" href="mailto:lenny.letyrant@gmail.com">lenny.letyrant[at]gmail.com</a>
          </div>
          <div class="contact-item">
            <span class="contact-label">LinkedIn</span>
            <a class="project-link" href="https://www.linkedin.com/in/lenny-le-tyrant/">Lenny Le Tyrant</a>
          </div>
        </div>
      </div>
    </div>

    <!-- FOOTER -->
    <div class="footer">
      <span>&copy; {currentYear} {t('footer.copyright')}</span>
      <span>{t('footer.exit')}</span>
    </div>

  </div>
</Layout>
